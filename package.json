{
  "name": "dsh-sensei",
  "version": "0.0.1",
  "description": "Agent-presented HTML slide deck for DeepSeek Harness: a right-sidebar stage with a transparent annotation layer",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "slides",
    "presentation"
  ],
  "exports": {
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./sensei.cordis.yml"
    }
  },
  "files": [
    "sensei.cordis.yml",
    "core",
    "shared",
    "host",
    "client",
    "lib",
    "vendor/dsh-blackboard/core",
    "vendor/dsh-blackboard/shared",
    "vendor/dsh-blackboard/LICENSE",
    "vendor/dsh-blackboard/VENDOR.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "node build/build-client.mjs",
    "test": "node --import tsx/esm --test --test-isolation=none \"tests/*.spec.ts\"",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "perfect-freehand": "1.2.3",
    "pptxgenjs": "4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "jsdom": "30.1.3",
    "tsx": "4.22.4",
    "typescript": "^6.0.3"
  }
}
